          <EntitySet Name="BlogDetails" EntityType="Self.BlogDetails" store:Type="Tables" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [BlogDetails].[BlogDetID] AS [BlogDetID], 
    [BlogDetails].[BlogTitle] AS [BlogTitle], 
    [BlogDetails].[BlogDescriptions] AS [BlogDescriptions], 
    [BlogDetails].[Status] AS [Status], 
    [BlogDetails].[CreationDate] AS [CreationDate], 
    [BlogDetails].[ImagePath] AS [ImagePath], 
    [BlogDetails].[ImageName] AS [ImageName], 
    [BlogDetails].[ShortDescriptions] AS [ShortDescriptions], 
    [BlogDetails].[VideoUrl] AS [VideoUrl], 
    [BlogDetails].[EntryDate] AS [EntryDate], 
    [BlogDetails].[Name] AS [Name], 
    [BlogDetails].[Email] AS [Email], 
    [BlogDetails].[Comments] AS [Comments], 
    [BlogDetails].[CommentsDate] AS [CommentsDate], 
    [BlogDetails].[CheckStatus] AS [CheckStatus], 
    [BlogDetails].[BlogID] AS [BlogID]
    FROM [dbo].[BlogDetails] AS [BlogDetails]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="BlogImages" EntityType="Self.BlogImages" store:Type="Tables" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [BlogImages].[BlogImageID] AS [BlogImageID], 
    [BlogImages].[imgURL] AS [imgURL], 
    [BlogImages].[BlogTitle] AS [BlogTitle], 
    [BlogImages].[BlogID] AS [BlogID]
    FROM [dbo].[BlogImages] AS [BlogImages]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="Blogs" EntityType="Self.Blogs" store:Type="Tables" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [Blogs].[BlogID] AS [BlogID], 
    [Blogs].[BlogTitle] AS [BlogTitle], 
    [Blogs].[Category] AS [Category], 
    [Blogs].[PagePath] AS [PagePath], 
    [Blogs].[BlogDescriptions] AS [BlogDescriptions], 
    [Blogs].[BlogDate] AS [BlogDate], 
    [Blogs].[Status] AS [Status], 
    [Blogs].[ImageName] AS [ImageName], 
    [Blogs].[ImagePath] AS [ImagePath], 
    [Blogs].[VideoUrl] AS [VideoUrl], 
    [Blogs].[ShortDescriptions] AS [ShortDescriptions], 
    [Blogs].[Tags] AS [Tags]
    FROM [dbo].[Blogs] AS [Blogs]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="PostTags" EntityType="Self.PostTags" store:Type="Tables" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [PostTags].[PostId] AS [PostId], 
    [PostTags].[TagId] AS [TagId]
    FROM [dbo].[PostTags] AS [PostTags]</DefiningQuery>
