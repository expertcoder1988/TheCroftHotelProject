    <script>
        $(document).ready(function () {
            var currentUrl = window.location.pathname;

            // Iterate through each navigation link and check if it matches the current URL
            $('.navbar-nav a').each(function () {
                var linkUrl = $(this).attr('href');

                if (currentUrl === linkUrl) {
                    $(this).closest('li').addClass('active');
                }
            });
        });
    </script>
    <script>
        // Get the current URL path
        var currentPath = window.location.pathname;

        // Select all menu items with class "items-list"
        var menuItems = document.querySelectorAll('.items-list');

        // Loop through the menu items
        menuItems.forEach(function (item) {
            // Get the href attribute of each menu item
            var itemPath = item.getAttribute('href');

            // Check if the current path matches the menu item's href
            if (currentPath === itemPath) {
                // Add the "active" class to the matching menu item
                item.classList.add('active');
            }
        });
    </script>

    <script>
        $(document).ready(function () {
            // Initialize date range picker for dtFrom2
            $('input[name="dtFrom2"]').daterangepicker({
                singleDatePicker: true,
                showDropdowns: true,
                minYear: 1901,
                autoClose: true,
                minDate: moment(),
                maxYear: parseInt(moment().format('YYYY'), 10),
                autoApply: true
            }, function (start, end, label) {
                // If no date selected, fallback to today
                if (!start) {
                    start = moment();
                }

                // Calculate the next day for dtTo2 default value
                let nextDay = moment(start).add(1, 'days');

                // Destroy any existing dtTo2 picker before reinitializing
                $('input[name="dtTo2"]').daterangepicker('destroy');

                // Re-initialize dtTo2 with new minDate and set next day as selected date
                initializeDtTo2(start, nextDay);
            });

            // Initialize date range picker for dtTo2
            function initializeDtTo2(minDate, defaultDate) {
                $('input[name="dtTo2"]').daterangepicker({
                    singleDatePicker: true,
                    showDropdowns: true,
                    minYear: 1901,
                    autoClose: true,
                    minDate: minDate,
                    startDate: defaultDate || minDate, // Use defaultDate if provided
                    maxYear: parseInt(moment().format('YYYY'), 10),
                    autoApply: true
                });
            }

            // Initial initialization of dtTo2 (from today's date + 1)
            let today = moment();
            let tomorrow = moment().add(1, 'days');
            initializeDtTo2(today, tomorrow);
        });
    </script>

