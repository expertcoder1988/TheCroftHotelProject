        <script>
            $(document).ready(function () {
                // Attach a click event handler to each carousel indicator
                $('.carousel-indicators li').click(function () {
                    // Get the index of the clicked indicator
                    var index = $(this).data('slide-to');

                    // Check if the index is valid
                    if (index >= 0 && index <= 2) {
                        // Redirect to the specified link
                        window.location.href = 'https://maps.app.goo.gl/7TyPnCVui7q8sFxq5';
                    }
                });
            });
        </script>


        <div id="faq-page" class="innerpage-section-padding">
            <div class="container">

                <div class="page-heading">
                    <h2>FAQs – <a style="color:#000" href="/naran-hotel-pictures">The Croft Family</a> Cottages in Naran</h2>
                    <hr class="heading-line" />
                </div>
                <div class="row">

                    <div class="col-md-12 col-lg-12 content-side">
                        <div class="faq-block">
                            <div class="card">
                                <div class="card-header">
                                    <a data-toggle="collapse" href="#collapse1"><h4 class="card-title">What types of rooms do you offer at The Croft Family Cottages?</h4></a>
                                </div><!-- end card-header -->

                                <div id="collapse1" class="panel-collapse collapse">
                                    <div class="card-body">
                                        <p>We provide a variety of accommodation options, including Single Rooms, Double Rooms, Twin Rooms, and Deluxe Rooms, each designed for comfort and a unique experience.</p>
                                    </div><!-- end card-body -->
                                </div><!-- end panel-collapse -->
                            </div><!-- end panel-default -->
                            <div class="card">
                                <div class="card-header">
                                    <a data-toggle="collapse" href="#collapse2"><h4 class="card-title">Are the rooms equipped with modern amenities?</h4></a>
                                </div><!-- end card-header -->

                                <div id="collapse2" class="panel-collapse collapse">
                                    <div class="card-body">
                                        <p>Absolutely! Our rooms feature modern amenities such as en-suite bathrooms, comfortable bedding, and complimentary Wi-Fi to ensure a delightful stay.</p>
                                    </div><!-- end card-body -->
                                </div><!-- end panel-collapse -->
                            </div><!-- end panel-default -->
                            <div class="card">
                                <div class="card-header">
                                    <a data-toggle="collapse" href="#collapse3"><h4 class="card-title">How far are you from popular attractions in Naran?</h4></a>
                                </div><!-- end card-header -->

                                <div id="collapse3" class="panel-collapse collapse">
                                    <div class="card-body">
                                        <p>We're strategically located near <a style="color:#000" href="/activities-in-naran-tourist-places">popular attractions</a> like Saif-ul-Mulook Lake and Lalazar, offering you convenient access to the breathtaking beauty of Naran.</p>
                                    </div><!-- end card-body -->
                                </div><!-- end panel-collapse -->
                            </div><!-- end panel-default -->
                            <div class="card">
                                <div class="card-header">
                                    <a data-toggle="collapse" href="#collapse4"><h4 class="card-title">Is parking available at The Croft Family Cottages?</h4></a>
                                </div><!-- end card-header -->

                                <div id="collapse4" class="panel-collapse collapse">
                                    <div class="card-body">
                                        <p>Yes, we provide ample parking space to ensure the safety and convenience of your vehicles during your stay with us.</p>
                                    </div><!-- end card-body -->
                                </div><!-- end panel-collapse -->
                            </div><!-- end panel-default -->
                            <div class="card">
                                <div class="card-header">
                                    <a data-toggle="collapse" href="#collapse5"><h4 class="card-title">Can you arrange transport for local sightseeing?</h4></a>
                                </div><!-- end card-header -->

                                <div id="collapse5" class="panel-collapse collapse">
                                    <div class="card-body">
                                        <p>Certainly! Our concierge can assist you in arranging transport for local sightseeing, ensuring you make the most of your Naran experience.</p>
                                    </div><!-- end card-body -->
                                </div><!-- end panel-collapse -->
                            </div><!-- end panel-default -->
                            <div class="card">
                                <div class="card-header">
                                    <a data-toggle="collapse" href="#collapse6"><h4 class="card-title">Are there dining options at The Croft Family Cottages?</h4></a>
                                </div><!-- end card-header -->

                                <div id="collapse6" class="panel-collapse collapse">
                                    <div class="card-body">
                                        <p>Yes, we have an <a style="color:#000" href="/naran-restaurant">on-site restaurant</a> serving a variety of local and international dishes, providing a culinary treat for our guests.</p>
                                    </div><!-- end card-body -->
                                </div><!-- end panel-collapse -->
                            </div><!-- end panel-default -->
                            <div class="card">
                                <div class="card-header">
                                    <a data-toggle="collapse" href="#collapse7"><h4 class="card-title">What safety measures are in place at your cottages?</h4></a>
                                </div><!-- end card-header -->

                                <div id="collapse7" class="panel-collapse collapse">
                                    <div class="card-body">
                                        <p>Your safety is our priority. We have implemented strict safety protocols, including 24/7 security, to ensure a secure and comfortable stay.</p>
                                    </div><!-- end card-body -->
                                </div><!-- end panel-collapse -->
                            </div><!-- end panel-default -->
                            <div class="card">
                                <div class="card-header">
                                    <a data-toggle="collapse" href="#collapse8"><h4 class="card-title">Can I get assistance with trekking and adventure activities?</h4></a>
                                </div><!-- end card-header -->

                                <div id="collapse8" class="panel-collapse collapse">
                                    <div class="card-body">
                                        <p>Absolutely! Our staff can help arrange trekking and adventure activities, allowing you to explore the rugged beauty of Naran to the fullest.</p>
                                    </div><!-- end card-body -->
                                </div><!-- end panel-collapse -->
                            </div><!-- end panel-default -->
                            <div class="card">
                                <div class="card-header">
                                    <a data-toggle="collapse" href="#collapse9"><h4 class="card-title">Are family-friendly facilities available?</h4></a>
                                </div><!-- end card-header -->

                                <div id="collapse9" class="panel-collapse collapse">
                                    <div class="card-body">
                                        <p>Yes, we cater to families with amenities like spacious family rooms, kid-friendly activities, and a serene environment for a memorable family vacation.</p>
                                    </div><!-- end card-body -->
                                </div><!-- end panel-collapse -->
                            </div><!-- end panel-default -->
                            <div class="card">
                                <div class="card-header">
                                    <a data-toggle="collapse" href="#collapse10"><h4 class="card-title">How can I make a reservation at The Croft Family Cottages?</h4></a>
                                </div><!-- end card-header -->

                                <div id="collapse10" class="panel-collapse collapse">
                                    <div class="card-body">
                                        <p>
                                            Booking with us is easy! You can make a reservation directly through our website or dial our<a style="color:#000" href="/hotel-naran-contact-number"> Naran Hotel contact number</a> to reach our reservations team for assistance.
                                            </p>
                                    </div><!-- end card-body -->
                                </div><!-- end panel-collapse -->
                            </div><!-- end panel-default -->

                        </div><!-- end faq-block -->


                    </div><!-- end columns -->

                </div><!-- end row -->
            </div><!-- end container -->
        </div><!-- end faq-page -->
        <!--======================= FOOTER =======================-->

        <section id="latest-blog" class="section-padding">
            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="page-heading">
                            <h2>Our Latest Blogs</h2>
                            <hr class="heading-line" />
                        </div>

                        <div class="row">
                            @foreach (var ro in blogs.Take(3))
                            {
                                string detailUrl = "/post/" + ro.PostId + "/" + ro.Slug;

                                <div class="col-md-6 col-lg-4">
                                    <div class="main-block latest-block">
                                        <div class="main-img latest-img">
                                            <a href="#">
                                                <img src="~/Uploads/blog/@ro.DefaultImage" class="img-fluid" alt="@ro.Title" />
                                            </a>
                                        </div>

                                        <div class="latest-info">
                                            <ul class="list-unstyled">
                                                <li>
                                                    <span><i class="fa fa-calendar-minus-o"></i></span>@Convert.ToDateTime(ro.PublishedDate).ToString("dd MMMM, yyyy")
                                                    <span class="author">by: <a href="#">@ro.Author</a></span>
                                                </li>
                                            </ul>
                                        </div>

                                        <div class="main-info latest-desc">
                                            <div class="row">
                                                <div class="col-10 col-md-10">
                                                    <a style="color: #000" href='@detailUrl'>@ro.Title</a>
                                                    <p class="truncate-para" title="@ro.ShortDescriptions">@ro.ShortDescriptions</p>
                                                </div>
                                            </div>
                                            <span class="arrow"><a href="#"><i class="fa fa-angle-right"></i></a></span>
                                        </div>
                                    </div>
                                </div>
                            }

                        </div><!-- end row -->

                    </div><!-- end columns -->
                </div><!-- end row -->
            </div><!-- end container -->
        </section>
        <section id="footer" class="ftr-heading-o ftr-heading-mgn-1">

            <div id="footer-top" class="banner-padding ftr-top-grey ftr-text-white">
                <div class="container">
                    <div class="row">

                        <div class="col-12 col-md-6 col-lg-4 col-xl-4 footer-widget ftr-about">
                            <div class="main-title-2">

                                <h3 class="footer-heading" >
                                    <a  style="font-size:26px" href="/">
                                    The Croft Family Cottages Naran
                                    </a>
