    <script>
        function SearchResults2() {
            var buttons = document.querySelectorAll('.srch');
            var StartDate = document.getElementsByName('dtFrom2')[0].value;
            var EndDate = document.getElementsByName('dtTo2')[0].value;
            var RoomValue = document.getElementsByName('NumOfRooms')[0].value;
            var Adults = document.getElementsByName('Adults')[0].value;
            var Kids = document.getElementsByName('Kids')[0].value;

            if (StartDate === EndDate) {
                alert("Check-out should not occur on the same date as check-in");
                return false;
            }

            // Loop through each button and disable it
            buttons.forEach(function (button) {
                button.disabled = true;
            });

            window.location.href = "/Home/PropertySearch?CheckIn=" + StartDate + "&CheckOut=" + EndDate + "&Adults=" + Adults + "&Children=" + Kids + "&NoOfRooms=" + RoomValue;
        }
    </script>

