@{
    ViewBag.Title = "Hotel Naran Contact Number | Croft Family Cottages";
    ViewBag.keywords = "Hotel Naran Contact Number, Naran hotel phone number, Naran Hotel Contact Details";
    ViewBag.canonical = "https://thecroftcottages.com/hotel-naran-contact-number";
    ViewBag.Description = "Connect with Croft Family Cottages Naran using our hotel Naran contact number. Reach us for room reservations, rate inquiries, and assistance.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="page-cover back-size" id="cover-flight-grid-list">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h2 class="page-title">CONTACT US</h2>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Home</a></li>
                    <li class="breadcrumb-item">Contact Us</li>
                </ul>
            </div><!-- end columns -->
        </div><!-- end row -->
    </div><!-- end container -->
</section>


<!--===== INNERPAGE-WRAPPER ====-->
<section class="innerpage-wrapper">
    <div id="contact-us" class="innerpage-section-padding">
        <div class="container">
            <div class="page-heading">
                <h1>Contact Number Croft Family Cottages Naran </h1>
                <hr class="heading-line">
                <blockquote>
                    Welcome to Croft Family Cottages Naran, where your comfort is our priority. Dial our hotel Naran contact number for instant assistance with reservations, inquiries, or any specific requests you may have. Whether you have inquiries about booking your stay amidst the breathtaking landscapes of Naran or want to learn more about our accommodations, our dedicated team is here to assist you. Feel free to reach out using the contact details below:
                    At Croft Family Cottages Naran, we value your inquiries and feedback. Your journey to a serene escape begins with a simple message or call. Contact us today, and let us assist you in creating unforgettable memories amidst the picturesque landscapes of Naran.

                </blockquote>
            </div>
            <div class="row" style="align-self:center ;justify-content:center">

                <div class="col-md-12 col-lg-5 no-pd-r mb-4">
                    <div class="custom-form contact-form">
                      
                    <form id="frm_contact" name="frm_contact" method="post">

                            <div class="form-group">
                                <input type="text" class="form-control" placeholder="Name" name="txt_name" id="txt_name" />
                                <span><i class="fa fa-user"></i></span>
                            </div>

                            <div class="form-group">
                                <input type="email" class="form-control" placeholder="Email" name="txt_email" id="txt_email" />
                                <span><i class="fa fa-envelope"></i></span>
                            </div>

                            <div class="form-group">
                                <input type="text" class="form-control" placeholder="Subject" name="txt_phone" id="txt_phone" />
                                <span><i class="fa fa-phone"></i></span>
                            </div>

                            <div class="form-group">
                                <textarea class="form-control" rows="4" placeholder="Your Message" name="txt_message" id="txt_message"></textarea>
                                <span><i class="fa fa-pencil"></i></span>
                            </div>
                            <div class="col-md-12 text-center" id="result_msg"></div>
                            <button name="submit" id="submit" class="btn btn-orange btn-block">Send</button>
                        </form>
                    </div><!-- end contact-form -->
                </div><!-- end columns -->

                <div class="col-md-12 col-lg-5 no-pd-r">
                    <div class="custom-formm contact-form">
                        <div class="contact-details">
                            <h3>Our Contact Details</h3>
                            <div class="ci-box d-flex">
                                <div class="icon-container">
                                    <i class="fa fa-map-marker"></i>
                                </div>
                                <div class="detail align-self-center">
                                    <h4>Hotel Address</h4>
                                    <p>
                                        <a href="https://maps.app.goo.gl/saaZo6xGyUEd3h2a7" style="color:#000">
                                            The Croft Cottages Main Mansehra-Naran Road
                                        </a>
                                    </p>
                                </div>
                            </div>

                            <div class="ci-box d-flex">
                                <div class="icon">
                                    <i class="fa fa-phone"></i>
                                </div>
                                <div class="detail align-self-center">
                                    <h4>Phone Number</h4>
                                    <p>
                                        <a href="tel:+923128888443" style="color:#000">Office: +92 312 8888 443</a>
                                    </p>
                                </div>
                            </div>
                            <div class="ci-box d-flex">
                                <div class="icon">
                                    <i class="fa fa-envelope"></i>
                                </div>
                                <div class="detail align-self-center">
                                    <h4>Email Address</h4>
                                    <p>
                                        <a href="mailto:info@thecroftcottages.com" style="color:#000">info@thecroftcottages.com</a>
                                    </p>
                                </div>
                            </div>
                            
                            <br />
                            <br />
                            <h3>Follow Us</h3>
                            <div class="social-media sidebar-widget clearfix">
                                <!-- Main Title 2 -->
                                <div class="main-title-2">
                                    <h3 style="color:#fff"><span>Social</span> Media</h3>
                                </div>
                                <!-- Social list -->
                                <ul class="social-list">
                                    <li>
                                        <a href="https://www.facebook.com/croftfamilycottages"
                                           class="facebook-bg">
                                            <i class="fa fa-facebook"></i>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="https://twitter.com/CroftCottages1" class="twitter-bg">
                                            <i class="fa fa-twitter"></i>
                                        </a>
                                    </li>

                                    <li>
                                        <a href="https://www.instagram.com/thecroftfamilycottages
"
                                           class="google-bg">
                                            <i class="fa fa-instagram"></i>
                                        </a>
                                    </li>
                                    @Html.Raw("<li class='list-inline-item'><a href='https://www.youtube.com/@TheCroftFamilyCottagesNaran'><span><i class='fa fa-youtube-play'></i></span></a></li>")


                                </ul>
                            </div>

                        </div>
                    </div><!-- end contact-form -->

                </div><!-- end columns -->



            </div><!-- end row -->
        </div><!-- end container -->
    </div><!-- end contact-us -->
</section><!-- end innerpage-wrapper -->

<section class="innerpage-wrapper">
    <div id="contact-us-2">

        <div class="map">
            <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d13087.626359201722!2d73.6648507!3d34.9087936!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x38e74f1075e69013%3A0xaa6e148f5090a360!2sThe%20Croft%20Family%20Cottages!5e0!3m2!1sen!2s!4v1703240591515!5m2!1sen!2s" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div
><!-- end map -->

    </div><!-- end contact-us -->
</section><!-- end innerpage-wrapper -->
<!-- end columns -->
<!--===== INNERPAGE-WRAPPER ====-->

