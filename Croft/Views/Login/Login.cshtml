
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="box-body">
    <div class="page_loader"></div>
    <!-- Content area start -->
    <div class="content-area">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <!-- Form content box start -->
                    <div class="form-content-box">
                        <!-- details -->
                        <div class="details">
                            <!-- Main title -->
                            <div class="main-title">
                                <h3><span>Mount Feast | Admin Panel</span></h3>
                            </div>
                            @using (Html.BeginForm("Login", "Login", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @*<form id="form1">*@
                                <div class="form-group">
                                    <input type="text" ID="txtUsername" name="username" required placeholder="User Name" class="input-text" />
                                </div>
                                <div class="form-group">
                                    <input ID="txtPassword" type="password" name="password" required placeholder="Password" class="input-text" />

                                </div>
                                <div class="checkbox">
                                    <div class="ez-checkbox pull-left">
                                        <label>
                                            <input type="checkbox" class="ez-hide">
                                            Remember me
                                        </label>
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                                <div class="form-group">
                                    <input class="btn btn-primary" type="submit" value="Sign in" />
                                </div>
                                @*</form>*@
                            }
                            <!-- Form end -->
                        </div>
                        <!-- Footer -->
                        <div class="footer">
                            <div class="row">
                                <div class="col-sm-12">

                                </div>
                            </div>
                        </div>
                        <!-- Form content box end -->
                    </div>
                </div>
            </div>
        </div>
        <!-- Content area end -->
    </div>

</div>