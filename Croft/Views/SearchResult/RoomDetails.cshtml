
@{

    ViewBag.Title = "Iconic Hotel  at Naran | Room Details";
    ViewBag.keywords = "Hotel at Naran";

    ViewBag.Description = "Iconic Hotel  at Naran is the best place to stay. Our hotel in Naran Pakistan offers luxurious rooms, equipped with all the amenities. Book Online.";

    Layout = "~/Views/Shared/_Layout.cshtml";

    //Croft.Models.RoomDetails results = new Croft.Models.RoomDetails();
    //if (TempData.ContainsKey("room"))
    //{
    //    results = (Croft.Models.RoomDetails)TempData["room"];
    //}

    List<Croft.Controllers.PropertySearch> results = new List<Croft.Controllers.PropertySearch>();
    Croft.Controllers.RoomDetails result = (Croft.Controllers.RoomDetails)ViewBag.room;

    int? TotalAmount = 0;
    List<Croft.Controllers.Pictures> roomPictures = (List<Croft.Controllers.Pictures>)TempData["roomPictures"];
    //var pics = roomPictures.Select(x => x.title).ToList()
    DateTime _CheckIn = DateTime.Now;
    DateTime _CheckOut = DateTime.Now;
    int? _RoomCatCode = 0;
    int? _adults = 0;
    int? _children = 0;
    int? _NoOfRooms = 0;
    int? _adultsRate = 0;
    int? _childrenRate = 0;
    int? roomPrice = 0;
    int? _TotalAmount = 0;
    int? _Discount = 0;

    if (Session["results"] != null)
    {
        string Params = (string)Session["params"];
        string[] p = Params.Split('&');
        _adults = Convert.ToInt32(p[2]);
        _children = Convert.ToInt32(p[3]);
        _NoOfRooms = Convert.ToInt32(p[4]);
        results = (List<Croft.Models.PropertySearch>)Session["results"];

        _adultsRate = results.Where(x => x.RoomCateCode == result.RoomCategoryId).Select(x => x.ExtraAdultPrice).FirstOrDefault();
        _childrenRate = results.Where(x => x.RoomCateCode == result.RoomCategoryId).Select(x => x.ExtraChildPrice).FirstOrDefault();
        _TotalAmount = results.Where(x => x.RoomCateCode == result.RoomCategoryId).Select(x => x.TotalAmount).FirstOrDefault();
        _Discount = results.Where(x => x.RoomCateCode == result.RoomCategoryId).Select(x => x.Discount).FirstOrDefault();

        if (_Discount == null)
        {
            _Discount = 0;
        }
        // if (_children > 0)
        {
            roomPrice = _TotalAmount - (_TotalAmount * _Discount / 100) + _adultsRate + _childrenRate;
        }
        //else
        //{
        //    roomPrice = _adultsRate;
        //}

        TotalAmount = roomPrice; //results.Where(x => x.RoomCateCode == result.RoomCategoryId).Select(x => x.TotalAmount).FirstOrDefault();
        string[] sDate = p[0].Split('-');
        string startDate = sDate[1] + "/" + sDate[0] + "/" + sDate[2];

        sDate = p[1].Split('-');
        string endDate = sDate[1] + "/" + sDate[0] + "/" + sDate[2];

        _CheckIn = Convert.ToDateTime(startDate);
        _CheckOut = Convert.ToDateTime(endDate);
        _RoomCatCode = result.RoomCategoryId;
    }

}

