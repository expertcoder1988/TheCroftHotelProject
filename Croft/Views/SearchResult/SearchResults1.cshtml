<script type="text/javascript">
    var $j = jQuery.noConflict();
    var value = 0;
    var DiscountedAmount = 0

    $j(function () {

        $j("input[name='RemoveRooms']").hide();

        $j("input[name='CalculateMinus']").on('click', function (e) {
            var id = ($j(this).data("value"));
            //alert(id);
            if ($j('#txtQuatntity_' + id).val() > 1) {
                value = parseInt($j('#txtQuatntity_' + id).val() - 1);
                $j('#txtQuatntity_' + id).val(value);
                totalAmount = parseInt($j('#hdNormalPrice_' + id).val() * value);
                $("#spNormalPrice_" + id).html(totalAmount);
                DiscountedAmount = parseInt($j('#hdDiscountedPrice_' + id).val() * value);
                $("#spDiscountedPRice_" + id).html(DiscountedAmount);
            }

            Calculate(id);
        });

        $j("input[name='CalculatePlus']").on('click', function (e) {
            var id = ($j(this).data("value"));
            var _NoOfRoomsLeft = $j('#NoOfRoomsLeft_' + id).val();
            if ($j('#txtQuatntity_' + id).val() < parseInt(_NoOfRoomsLeft)) {
                value = parseInt($j('#txtQuatntity_' + id).val()) + 1;
                $j('#txtQuatntity_' + id).val(value);
                totalAmount = parseInt($j('#hdNormalPrice_' + id).val() * value);
                $("#spNormalPrice_" + id).html(totalAmount);
                $('#hdNormalPrice_' + id).html(totalAmount);
                DiscountedAmount = parseInt($j('#hdDiscountedPrice_' + id).val() * value);
                $("#spDiscountedPRice_" + id).html(DiscountedAmount);

                debugger
            }

            Calculate(id);
        });

        $j("input[name='ShowDetails']").click(function () {
            var _id = $j(this).attr('id');
            _id = _id.split('_');
            _id = _id[1];

            $j("#SelectRoom_" + _id).prop("checked", true);
            // $j("#RemoveRooms_" + _id).show();
            Calculate(_id);
        });

        $j("input[name='RemoveRooms']").click(function () {
            var _id = $j(this).attr('id');
            _id = _id.split('_');
            _id = _id[1];

            $j("#SelectRoom_" + _id).prop("checked", false);

            Calculate(_id);
            $j("#RemoveRooms_" + _id).hide();
        });

        function Calculate(_Id) {
            //var i = 0;
            var TotalRooms = 0;
            var GrandTotal = 0;
            var RoomCate = "";
            var _RoomCateRoomNums = '';
            var _RatePlanID = '';
            var _RoomRates = '';
            var _RoomRatesN = '';
            var flag = 0;

            debugger

            //var _Id = $j(this).attr('id');
            //_Id = _Id.split('_');
            //_Id = _Id[1];
            var _roomCate = $j('#hdRoomCate_' + _Id).val();
            //alert($j('#txtQuatntity_' + _Id).val());
            //  _roomCate = _roomCate.split('_');
            //  _roomCate = _roomCate[1];

            var roomCateRoomNums = $j('#txtQuatntity_' + _Id).val();
            //roomCateRoomNums = roomCateRoomNums.split('_');
            //roomCateRoomNums = roomCateRoomNums[1];

            // alert(roomCateRoomNums);

            _RoomRates = _RoomRates + ',' + $j('#hdDiscountedPrice_' + _Id).val();
            _RoomRatesN = _RoomRatesN + ',' + $j('#hdNormalPrice_' + _Id).val();
            var _ratePlanID = $j('#RatePlanID_' + _Id).attr('id');
            _ratePlanID = _ratePlanID.split('_');
            _ratePlanID = _ratePlanID[1];
            _RatePlanID = _RatePlanID + "," + _ratePlanID;

            TotalRooms = TotalRooms + parseInt($j("#txtQuatntity_" + _Id).val());
            GrandTotal = GrandTotal + parseInt($j("#spDiscountedPRice_" + _Id).html());
            if (isNaN(GrandTotal) || GrandTotal == 0) {
                GrandTotal = parseInt($j('#hdNormalPrice_' + _Id).val() * TotalRooms);

            }
            RoomCate = RoomCate + "," + _roomCate;
            _RoomCateRoomNums = _RoomCateRoomNums + "," + roomCateRoomNums;

            // alert(GrandTotal);
            $j('#RatePlanIDs').val(_RatePlanID);
            $j('#hdTotalRooms').val(TotalRooms);
            $j('#hdTotalAmount').val(GrandTotal);
            $j('#_TotalRooms').html(TotalRooms);
            $j('#_TotalAmount').html(GrandTotal);
            $j('#_TotalRooms1').html(TotalRooms);
            $j('#_TotalAmount1').html(GrandTotal);
            $j('#RoomCatCode').val(RoomCate);
            $j('#RoomCateRoomNums').val(_RoomCateRoomNums);
            $j('#RoomRates').val(_RoomRates);
            //     console.log($j('#RoomRates').val());
            // console.log($j('#hdTotalAmount').val());
            flag = 1;
            if (GrandTotal == 0) {
                alert("Please select atleast one room.")
            }
            else {
                //  $('#myModal').modal('show');
                //  $j("#sticky").show();
            }
        }


        $('#OpenModal').click(function () {
            $('#myModal').modal('show');
            $("#sticky").hide();
        });

        $('#closemodal').click(function () {
            $('#myModal').modal('hide');
            $("#sticky").show();
        });

        $('#closepicmodal').click(function () {
            $('#carouselModal').modal('hide');
        });

        $('#closepolicymodal').click(function () {
            $('#policyModal').hide();
        });

        $j("#dvPolicy a").click(function () {

            var _id = $j(this).attr('id');
            _id = _id.split('_');
            _id = _id[1];

            try {
                $.ajax({
                    url: '/SearchResult/RoomPolicy',
                    type: 'GET',
                    dataType: 'json',
                    contentType: 'application/json',
                    data: '&CancellationPolicy=' + _id,
                    success: function (data) {
                        $("#policyName").empty();
                        $("#Breakfst").empty();
                        $("#CancellationPolicy").empty();
                        $("#FreeCancelBefore").empty();
                        $("#GuestChargedForCancellation").empty();
                        $("#ChargedForNoShow").empty();
                        // alert(_id)
                        // console.log(data);
                        if (data.length > 0) {
                            $.each(data, function (i, item) {
                                if (i == 0) {
                                    $("#policyName").append(item.RatePlanName);

                                    if (item.Breakfst == 1) {
                                        $("#Breakfst").append("Included");
                                    }
                                    else {
                                        $("#Breakfst").append("Not Included");
                                    }

                                    $("#CancellationPolicy").append(item.CancellationPolicy);

                                    if (item.ChargedForNoShow == 1) {
                                        $("#ChargedForNoShow").append("Same as the cancellation fee");
                                    }
                                    else {
                                        $("#ChargedForNoShow").append("100% of the total price");
                                    }

                                    if (item.FreeCancelBefore == 1) {
                                        $("#FreeCancelBefore").append("The cost of the first night");
                                    }
                                    else if (item.FreeCancelBefore == 2) {
                                        $("#FreeCancelBefore").append("50% of the total price");
                                    }
                                    else {
                                        $("#FreeCancelBefore").append("100% of the total price");
                                    }


                                    if (item.HowlongFreeOfCharge == 1) {
                                        $("#GuestChargedForCancellation").append("until 6:00PM on the day of arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 2) {
                                        $("#GuestChargedForCancellation").append("until 2:00PM on the day of arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 3) {
                                        $("#GuestChargedForCancellation").append("until 1 day before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 4) {
                                        $("#GuestChargedForCancellation").append("until 2 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 5) {
                                        $("#GuestChargedForCancellation").append("until 3 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 6) {
                                        $("#GuestChargedForCancellation").append("until 5 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 7) {
                                        $("#GuestChargedForCancellation").append("until 7 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 8) {
                                        $("#GuestChargedForCancellation").append("until 14 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 9) {
                                        $("#GuestChargedForCancellation").append("until 21 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 10) {
                                        $("#GuestChargedForCancellation").append("until 28 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 11) {
                                        $("#GuestChargedForCancellation").append("until 30 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 12) {
                                        $("#GuestChargedForCancellation").append("until 42 days before arrival");
                                    }
                                    else if (item.HowlongFreeOfCharge == 13) {
                                        $("#GuestChargedForCancellation").append("until 60 days before arrival");
                                    }
                                    else {
                                        $("#FreeCancelBefore").append("No Free Cancellation");
                                    }

                                    debugger
                                    $j("#policyModal").show();
                                }
                            });
                        }
                    },
                    error: function (err) {
                        alert(err.status + " : " + err.statusText);
                    }

                });
            } catch (e) {
                alert(e.status + " : " + e.statusText);
                // window.location.href = '/Booking/BookingList';
            }
        });
    });
</script>


<div class="sub-banner overview-bgi">
