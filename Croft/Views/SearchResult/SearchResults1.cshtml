<div id="policyModal" class="modal fade" role="dialog"style="opacity:1 !important">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content" style="padding:0px !important">
            <div class="modal-header justify-content-end">
                <button type="button" id="closepolicymodal" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="banner" id="banner2">
                    <p><b>Policy: </b> <span id="policyName"></span></p>
                    <p><b>Breakfast: </b> <span id="Breakfst"></span></p>
                    <p><b>Cancellation Policy: </b> <span id="CancellationPolicy"></span></p>
                    <p><b>Free Cancel Before: </b> <span id="GuestChargedForCancellation"></span></p>
                    <p><b>Guest Charged For Cancellation: </b><span id="FreeCancelBefore"></span> </p>
                    <p><b>Charged For No-Show: </b> <span id="ChargedForNoShow"></span></p>
                </div>
            </div>
        </div>
    </div>
</div>

