@{

    ViewBag.Title = "The Croft Hotel  at Naran | Available Rooms";
    ViewBag.keywords = "Hotel at Naran";

    ViewBag.Description = "The Croft Hotel  at Naran is the best place to stay. Our hotel in Naran Pakistan offers luxurious rooms, equipped with all the amenities. Book Online.";


    List<Croft.Controllers.PropertySearch> results = new List<Croft.Controllers.PropertySearch>();

    string _CheckIn = "";// DateTime.Now;
    string _CheckOut = ""; // DateTime.Now;

    int checkRooms = 0;

    int? _adults = 0;
    int? _children = 0;
    int? _NoOfRooms = 0;
    int? roomPrice = 0;
    int? _TotalPax = 0;
    string Params = (string)Session["params"];
    string[] p = Params.Split('&');

    _CheckIn = Convert.ToString(p[0]);
    _CheckOut = Convert.ToString(p[1]);
    _adults = Convert.ToInt32(p[2]);
    _children = Convert.ToInt32(p[3]);
    _NoOfRooms = Convert.ToInt32(p[4]);
    _TotalPax = _adults + _children;

    List<Croft.Controllers.RoomImages> Img = new List<Croft.Controllers.RoomImages>();

    if (TempData["Images"] != null)
    {
        Img = (List<Croft.Controllers.RoomImages>)TempData["Images"];
    }

    if (_TotalPax == 0)
    {
        _TotalPax = 1;
    }

    if (Session["results"] != null)
    {
        results = (List<Croft.Controllers.PropertySearch>
            )Session["results"];
    }

    //  TimeSpan t = Convert.ToDateTime(_CheckIn) - Convert.ToDateTime(_CheckOut);
    // int noOfDay = (int)t.TotalDays;
}

