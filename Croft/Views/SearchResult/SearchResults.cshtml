<script>
    $(document).ready(function () {

        function initializeDtTo2(minDate, defaultDate) {
            $('input[name="dtTo2"]').daterangepicker({
                singleDatePicker: true,
                showDropdowns: true,
                minYear: 1901,
                minDate: minDate,
                startDate: defaultDate,
                autoApply: true,
                locale: {
                    format: 'MM/DD/YYYY'
                }
            });
        }

        // Initialize Check-In Picker
        $('input[name="dtFrom2"]').daterangepicker({
            singleDatePicker: true,
            showDropdowns: true,
            minYear: 1901,
            minDate: moment(),
            autoApply: true,
            locale: {
                format: 'MM/DD/YYYY'
            }
        }, function (start) {
            let nextDay = moment(start).add(1, 'days');

            // Reset and re-init Check-Out
            $('input[name="dtTo2"]').val('');
            $('input[name="dtTo2"]').data('daterangepicker').remove();

            initializeDtTo2(start, nextDay);
        });

        // Initial setup of Check-Out with tomorrow
        let today = moment();
        let tomorrow = moment().add(1, 'days');
        initializeDtTo2(today, tomorrow);
    });
</script>


