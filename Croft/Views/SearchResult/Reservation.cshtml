<script>
    document.addEventListener('DOMContentLoaded', function () {
        var payNowRadioButton = document.getElementById('PaymentType1');
        var payLaterRadioButton = document.getElementById('PaymentType2');
        var totalPriceElement = document.getElementById('totalPriceCell');
        var discountedPriceElement = document.getElementById('discountedPriceCell');
        var discountedPriceRow = document.getElementById('discountedPriceRow');

        // Initial values
        var DiscountedAmount = @DiscountedAmount; // Fetch the discounted amount from your server-side code
        var TotalAmount = @TotalAmmount; // Fetch the total amount from your server-side code

        if (totalPriceElement && discountedPriceElement && discountedPriceRow) {
            function updatePriceDisplay() {
                if (payNowRadioButton.checked) {
                    totalPriceElement.innerText = 'Rs. ' + DiscountedAmount; // Show discounted amount for Pay Now
                    discountedPriceElement.innerText = 'Rs. ' + DiscountedAmount;
                    discountedPriceElement.style.display = 'block';
                    discountedPriceRow.style.display = 'table-row'; // Show discounted row
                } else {
                    totalPriceElement.innerText = 'Rs. ' + TotalAmount; // Show total amount for Pay Later
                    discountedPriceElement.innerText = 'Rs. ' + 0;
                    discountedPriceRow.style.display = 'table-row'; // Hide discounted row
                }
            }

            // Initialize the display based on the default selected payment type
            updatePriceDisplay();

            // Event listeners for radio button change
            payNowRadioButton.addEventListener('change', updatePriceDisplay);
            payLaterRadioButton.addEventListener('change', updatePriceDisplay);
        } else {
            console.error("Element not found: totalPriceCell, discountedPriceCell, or discountedPriceRow");
        }
    });
</script>

<script>
    var isVoucherApplied = false; // Flag to check if the voucher is already applied

    let originalAmount = null; // Declare this globally

    function applyVoucher() {
        if (isVoucherApplied) {
            alert('Voucher has already been applied.');
            return;
        }

        var voucherCode = document.getElementById('voucherCode').value;
        var totalAmountField = document.getElementById('totalPriceCell');
        var totalAmountField1 = document.getElementById('totalPriceCell1');
        var discountedAmountField = document.getElementById('discountedPriceCell');
        var hiddenVoucherCodeField = document.getElementById('hiddenVoucherCode');

        if (!totalAmountField || !totalAmountField1 || !discountedAmountField || !hiddenVoucherCodeField) {
            console.error('One or more required fields are not found');
            return;
        }

        // Store original amount only once
        if (!originalAmount) {
            originalAmount = totalAmountField.innerText;
        }

        $.ajax({
            url: '/SearchResult/GetDiscountAmount',
            type: 'POST',
            data: { code: voucherCode },
            success: function (response) {
                if (response.success) {
                    var totalAmount = parseFloat(totalAmountField.innerText.replace('Rs. ', '').replace(',', ''));
                    var discountAmount = response.discountAmount;
                    var newTotalAmount = totalAmount - discountAmount;

                    discountedAmountField.innerText = 'Rs. ' + discountAmount;
                    totalAmountField.innerText = 'Rs. ' + newTotalAmount;
                    totalAmountField1.innerText = 'Rs. ' + newTotalAmount;
                    document.getElementById('discountedPriceRow').style.display = 'table-row';

                    isVoucherApplied = true;
                    hiddenVoucherCodeField.value = voucherCode;
                } else {
                    alert('Invalid voucher code');
                }
            },
            error: function () {
                alert('An error occurred while applying the voucher code.');
            }
        });
    }

    function removeVoucher() {
        var totalAmountField = document.getElementById('totalPriceCell');
        var totalAmountField1 = document.getElementById('totalPriceCell1');
        var hiddenVoucherCodeField = document.getElementById('hiddenVoucherCode');

        if (!totalAmountField || !totalAmountField1 || !hiddenVoucherCodeField) {
            console.error('One or more required fields are not found');
            return;
        }

        if (!originalAmount) {
            console.error('Original amount not stored.');
            return;
        }

        totalAmountField.innerText = originalAmount;
        totalAmountField1.innerText = originalAmount;
        hiddenVoucherCodeField.value = '';
        isVoucherApplied = false;

        document.getElementById('discountedPriceRow').style.display = 'none';
        document.getElementById('voucherIcon').innerHTML = '';
        document.getElementById('applyVoucherBtn').disabled = false;
        document.getElementById('removeVoucherBtn').disabled = true;
        const applyBtn = document.getElementById('applyVoucherBtn');
        applyBtn.innerHTML = '<span id="voucherIcon" style="margin-right: 8px;"></span>Apply';

        originalAmount = null; // Reset
    }


</script>
<script>
    function calculateTotalDays() {
        var checkIn = new Date('@_CheckIn.ToString("yyyy-MM-dd")');
        var checkOut = new Date('@_CheckOut.ToString("yyyy-MM-dd")');
        var timeDiff = Math.abs(checkOut.getTime() - checkIn.getTime());
        var totalDays = Math.ceil(timeDiff / (1000 * 3600 * 24));
        return totalDays;
    }

    window.onload = function() {
        var totalDays = calculateTotalDays();
        document.getElementById("totalDays").textContent = totalDays;
    };
</script>
<script>
    function setPaymentType(element, value) {
        // Set hidden input value
        document.getElementById("PaymentType").value = value;

        // Deselect all cards
        document.querySelectorAll(".payment-card").forEach(card => {
            card.classList.remove("selected");
            card.querySelector(".checkmark").classList.add("d-none");
        });

        // Select the clicked card
        element.classList.add("selected");
        element.querySelector(".checkmark").classList.remove("d-none");
    }
</script>