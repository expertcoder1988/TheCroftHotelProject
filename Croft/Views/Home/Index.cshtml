<script>
    $(document).ready(function () {
        // Handle click event on "SELECT THIS ROOM" link
        $(".select-txt a").on("click", function (e) {
            e.preventDefault(); // Prevent the default behavior of the anchor tag
            $("#myModal").css("display", "block"); // Show the modal
        });

        // Handle click event on the modal close button
        $("#closemodal").on("click", function () {
            $("#myModal").css("display", "none"); // Hide the modal
        });

        // Handle click event outside the modal to close it
        $(window).on("click", function (e) {
            if (e.target === $("#myModal")[0]) {
                $("#myModal").css("display", "none"); // Hide the modal
            }
        });
    });
</script>

